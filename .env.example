# Copy this file to .env and fill in your real values. Never commit .env.

# Neon Postgres connection string (CMI database).
# Neon free-tier endpoints cold-start, so keep a generous connect timeout.
# A standard Postgres URI. Its parts, in order:
#   scheme "postgresql", then username, password, host, database name,
#   and the query parameter sslmode=require.
# Left blank deliberately — an example file should not ship a string shaped
# like a credential, so secret scanners have nothing to flag.
NEON_CONNECTION_STRING=

# --- LLM provider ---
# "deepseek" (recommended) | "openrouter" | "anthropic"
LLM_PROVIDER=deepseek

# DeepSeek native API — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# MAX_OUTPUT_TOKENS=8000

# OpenRouter (only if LLM_PROVIDER=openrouter) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=deepseek/deepseek-chat

# Exa semantic search — https://exa.ai (free tier). Without this, DDG lite is used.
EXA_API_KEY=exa_...

# change for b2c questionarie — consumer-voice sources (language/pain only; never %)
# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
YOUTUBE_ENABLED=true

# Reddit — prefer official OAuth (https://www.reddit.com/prefs/apps). Cookie/rdt = fallback.
REDDIT_ENABLED=true
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=survey-agent/1.0
# Optional cookie fallback (Windows: scripts/setup_reddit_cookies.py)
# REDDIT_CLI_COOKIE_PATH=./secrets/reddit-cookies.json

# Twitter/X — OFF by default (API is costly/gated; scraping is fragile + needs VPN)
TWITTER_ENABLED=false
# TWITTER_BEARER_TOKEN=

# Facebook: not supported — public FB search is not feasible without a partnership.

# Web fetch safety — disable to avoid DDG/Jina blocks when VPN rotator is off
# DDG_ENABLED=false
# JINA_ENABLED=false
# Limit Global fan-out (comma-separated). Empty = all 5 continents.
# RUN_REGIONS=Europe,North America

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# change for b2c questionarie — consulting-grade: 5–10 Q/section (target 8 → ~32 total)
QUESTIONS_PER_TAB_MIN=5
QUESTIONS_PER_TAB_MAX=10
QUESTIONS_PER_TAB_TARGET=8

# change for b2c questionarie — Phase A5: core_plus_module | fully_distinct
REGION_QUESTION_MODE=core_plus_module

# --- Parallel batch (RQ + Docker) ---
# Host enqueue uses localhost; Docker workers override to redis://redis:6379 in compose.
REDIS_URL=redis://localhost:6379
RQ_QUEUE_NAME=surveys
RQ_JOB_TIMEOUT=60m

# Container path for published surveys (set automatically in docker-compose).
FRONTEND_SURVEYS_DIR=/app/frontend-surveys
# Host path for the compose volume mount (Windows example — adjust to your checkout).
FRONTEND_SURVEYS_HOST_DIR=C:\Users\YOU\Downloads\coherent_b2c_survey_question_2\cmi-platform-ai\frontend-v2\apps\web\public\surveys

# Layer 2 rate limits — tune independently of worker count (--scale worker=N).
# Dial #2: API calls/sec. Lower LLM_RATE_PER_SEC if DeepSeek 429s appear.
LLM_RATE_PER_SEC=5
LLM_BURST=10
WEB_RATE_PER_SEC=1
WEB_BURST=3
STAGGER_SECONDS=30
STAGGER_CAP_SECONDS=180

# VPN rotation — Proton automation-tool on Windows host :8765
# Clone: https://github.com/Aman-Coherent/automation-tool (sibling ../automation-tool)
# Mode in the tool UI: "On scraper block". Verify egress: scripts/verify_vpn_egress.py
VPN_ROTATE_ENABLED=true
VPN_ROTATE_URL=http://host.docker.internal:8765
# VPN_CLIENT_ID=survey-agent/worker-1
